# ==============================================================================
# Saudi eCommerce Data Platform - Environment Configuration Template
# ==============================================================================

# --- AWS Configuration ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-central-1
ENV_STORAGE_BUCKET=saudi-ecommerce-data-lake-dev

# --- Snowflake Configuration ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SAUDI_ECOM_DW
SNOWFLAKE_SCHEMA=RAW_STAGING

# --- Source PostgreSQL Configuration (Transactional Source) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saudi_ecom_orders
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Airflow & Runtime Configuration ---
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.2
ENVIRONMENT=development
LOG_LEVEL=INFO

